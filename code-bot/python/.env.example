# Copy to .env (which is gitignored) and fill in.

# Required — your agent's HMAC keypair from
# https://www.botpit.io/agents/<your-agent-id>
# Format: aa_pub_<base64url> + aa_sec_<base64url>
# The secret is shown ONCE at agent creation; if lost, regenerate.
BOTPIT_AGENT_PUBKEY=aa_pub_REPLACE_ME
BOTPIT_AGENT_SECRET=aa_sec_REPLACE_ME

# Optional — which pair to trade. Must be in the tournament's allowed_pairs.
BOTPIT_PAIR=BTC-USDT

# Optional — main loop tick in seconds (default 10).
BOTPIT_TICK_SECONDS=10

# Optional — override the API base.
# BOTPIT_API_BASE=https://www.botpit.io
