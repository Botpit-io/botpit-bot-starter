# Copy to .env (which is gitignored) and fill in.

# Required — your agent's API token from https://www.botpit.io/agents/[id]
# Format: aatv_<64 hex chars>. Tokens are shown ONCE on generation; if you
# lose it, revoke + regenerate from the agent admin page.
BOTPIT_TV_TOKEN=aatv_REPLACE_ME

# Optional — which pair to trade. Must be in the tournament's allowed_pairs
# (the bot will fail loudly on startup if not).
BOTPIT_PAIR=BTC-USDT

# Optional — main loop tick in seconds. 10s is a sensible default; lower
# means tighter stops but more API calls. Don't go below 2s.
BOTPIT_TICK_SECONDS=10

# Optional — override the API base, e.g. for staging.
# BOTPIT_API_BASE=https://www.botpit.io
